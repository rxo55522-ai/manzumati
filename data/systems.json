    {
      "id": "foreign-currency",
      "name": "حجز النقد الأجنبي للأغراض الشخصية",
      "agency": "مصرف ليبيا المركزي",
      "url": "https://fcms.cbl.gov.ly",
      "group": "citizen",
      "prepare": "الرقم الوطني، ورقم هاتف مربوط بالرقم الوطني.",
      "steps": [
        {
          "title": "افتح الموقع الرسمي",
          "text": "ادخل من الزر \"ادخل للمنظومة\"، وتأكد إن الرابط fcms.cbl.gov.ly"
        },
        {
          "title": "اختار منظومة الأغراض الشخصية",
          "text": "من القائمة الرئيسية في موقع المصرف."
        },
        {
          "title": "دخّل بياناتك",
          "text": "الرقم الوطني ورقم هاتفك المربوط بيه، وكمّل التحقق اللي يطلبه منك الموقع."
        },
        {
          "title": "اضغط \"حجز\" وكمّل الطلب",
          "text": "راجع بياناتك قبل ما تبعت الطلب."
        },
        {
          "title": "استنى رسالة الموافقة",
          "text": "المصرف يراجع الطلب، ولما يوافق يوصلك إشعار باستلام المبلغ من الفرع المحدد."
        }
      ],
      "registration_closed": false,
      "hidden": false,
      "popular": true,
      "conditions": "لليبيين الساكنين داخل ليبيا، من عمر 18 سنة وفوق."
